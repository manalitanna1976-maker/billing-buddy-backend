DATABASE_URL=postgresql+psycopg://billing:billing@localhost:5432/billing_buddy
JWT_SECRET=change-me-in-production
# SECRET_ENCRYPTION_KEY: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- WhatsApp invoice-drafting feature ---
# Anthropic API key used by the message parser
ANTHROPIC_API_KEY=
# Meta app secret, used to verify the X-Hub-Signature-256 webhook signature
WHATSAPP_APP_SECRET=
# Token echoed back during the webhook GET verification handshake
WHATSAPP_VERIFY_TOKEN=
# Graph API version
WHATSAPP_API_VERSION=v21.0
# Graph API base URL
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Anthropic model used to parse inbound messages
WHATSAPP_PARSER_MODEL=claude-sonnet-5
# Max accepted inbound message size in bytes
WHATSAPP_MESSAGE_MAX_BYTES=2048
# Rate limit per sender, per 15 minutes
WHATSAPP_RATE_PER_SENDER=20
# Rate limit per business, per 15 minutes
WHATSAPP_RATE_PER_BUSINESS=100
# Max delivery attempts before a job is dead-lettered
WHATSAPP_JOB_MAX_ATTEMPTS=5
# Seconds before an in-flight job claim is considered stale and reclaimable
WHATSAPP_JOB_STALE_CLAIM_SECONDS=300
# Minutes a conversation context is retained
WHATSAPP_CONVERSATION_TTL_MINUTES=30
# Optional webhook URL that receives dead-lettered jobs
DEADLETTER_WEBHOOK_URL=
